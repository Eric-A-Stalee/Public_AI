{
  "name": "macro-terminal",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "refresh:data": "node scripts/refresh-data.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts config tests *.js index.html README.md package.json",
    "format:check": "prettier --check src scripts config tests *.js index.html README.md package.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
